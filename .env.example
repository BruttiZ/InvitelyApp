# Invitely local environment
# Copy this file to .env before running Docker locally.

APP_NAME=Invitely
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
FRONTEND_URL=http://localhost:8082
NEXT_PUBLIC_SITE_URL=http://localhost:8082

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker host ports
APP_PORT=8082
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local database. Docker always points the app to the postgres service.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=invitely
DB_USERNAME=invitely
DB_PASSWORD=secret

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@invitely.local
MAIL_FROM_NAME="${APP_NAME}"

# Local MinIO credentials. Keep FILESYSTEM_DISK=local unless testing S3 flows.
AWS_ACCESS_KEY_ID=invitely
AWS_SECRET_ACCESS_KEY=invitely-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=invitely
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

RUN_MIGRATIONS=true
RUN_SEEDERS=true

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=
VITE_SITE_URL=http://localhost:8082
VITE_PORT=5174
VITE_HOST=0.0.0.0
VITE_DEV_SERVER_ORIGIN=http://localhost:5174
VITE_HMR_HOST=localhost
VITE_CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
LARAVEL_API_URL=http://localhost:8082

# Optional external integrations. Leave empty for an isolated local stack.
INVITELY_API_BASE_URL=
INVITELY_API_KEY=
INVITELY_API_TIMEOUT=30
GO_API_URL=
GO_API_INTERNAL_KEY=
GO_API_TIMEOUT=30

INVITELY_REQUIRE_EMAIL_VERIFICATION=false
VITE_AUTH_OWNER_EMAIL=
VITE_AUTH_OWNER_NAME=
VITE_AUTH_PARTY_NAME=
VITE_AUTH_GUEST_EMAIL=
VITE_AUTH_GUEST_NAME=
VITE_AUTH_ADMIN_EMAIL=
VITE_AUTH_ADMIN_NAME=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
